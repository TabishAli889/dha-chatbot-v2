# Copy this file to .env and fill in your key. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here

# Optional: use Groq instead
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here

# Optional: choose model(s), comma-separated fallback order
# LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
